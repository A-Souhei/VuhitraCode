{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg0": "#050d2e",
    "bg1": "#0a1550",
    "bg2": "#0d1d6e",
    "bg3": "#152280",
    "bg4": "#1e2e99",
    "cyan": "#00c8ff",
    "cyanSoft": "#7ee8fa",
    "blue": "#2d5ce8",
    "magenta": "#e040fb",
    "magentaSoft": "#c084fc",
    "white": "#e8eeff",
    "muted": "#7a8bbf",
    "green": "#00e5a0",
    "orange": "#ff9d3d",
    "red": "#ff4466",
    "lightBg": "#eef2ff",
    "lightBg1": "#dde5ff",
    "lightBg2": "#ccd8ff",
    "lightBg3": "#99aaee",
    "lightText": "#0a1550",
    "lightMuted": "#4a5c9a",
    "lightCyan": "#0080cc",
    "lightMagenta": "#9b22c7",
    "diffAddedBgDark": "#0a2a1e",
    "diffRemovedBgDark": "#2a0a14",
    "diffAddedBgLight": "#d4f5e9",
    "diffRemovedBgLight": "#fde8ed"
  },
  "theme": {
    "primary": { "dark": "cyan", "light": "lightCyan" },
    "secondary": { "dark": "blue", "light": "blue" },
    "accent": { "dark": "cyanSoft", "light": "lightMagenta" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "cyan", "light": "lightCyan" },
    "text": { "dark": "white", "light": "lightText" },
    "textMuted": { "dark": "muted", "light": "lightMuted" },
    "background": { "dark": "bg0", "light": "lightBg" },
    "backgroundPanel": { "dark": "bg1", "light": "lightBg1" },
    "backgroundElement": { "dark": "bg2", "light": "lightBg2" },
    "border": { "dark": "bg3", "light": "lightBg3" },
    "borderActive": { "dark": "bg4", "light": "lightMuted" },
    "borderSubtle": { "dark": "bg3", "light": "lightBg3" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "muted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "blue", "light": "lightCyan" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "diffAddedBgDark", "light": "diffAddedBgLight" },
    "diffRemovedBg": { "dark": "diffRemovedBgDark", "light": "diffRemovedBgLight" },
    "diffContextBg": { "dark": "bg1", "light": "lightBg1" },
    "diffLineNumber": { "dark": "muted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "bg1", "light": "lightBg1" },
    "diffRemovedLineNumberBg": { "dark": "bg1", "light": "lightBg1" },
    "markdownText": { "dark": "white", "light": "lightText" },
    "markdownHeading": { "dark": "cyan", "light": "lightCyan" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "cyanSoft", "light": "lightMagenta" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "muted", "light": "lightMuted" },
    "markdownEmph": { "dark": "orange", "light": "orange" },
    "markdownStrong": { "dark": "magenta", "light": "lightMagenta" },
    "markdownHorizontalRule": { "dark": "bg3", "light": "lightBg3" },
    "markdownListItem": { "dark": "white", "light": "lightText" },
    "markdownListEnumeration": { "dark": "cyan", "light": "lightCyan" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "cyanSoft", "light": "lightMagenta" },
    "markdownCodeBlock": { "dark": "bg1", "light": "lightBg1" },
    "syntaxComment": { "dark": "muted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "cyan", "light": "lightCyan" },
    "syntaxFunction": { "dark": "magenta", "light": "lightMagenta" },
    "syntaxVariable": { "dark": "cyanSoft", "light": "lightCyan" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "magentaSoft", "light": "lightMagenta" },
    "syntaxType": { "dark": "cyanSoft", "light": "lightCyan" },
    "syntaxOperator": { "dark": "blue", "light": "lightMuted" },
    "syntaxPunctuation": { "dark": "white", "light": "lightText" }
  }
}
