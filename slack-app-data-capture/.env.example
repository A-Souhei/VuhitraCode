# ============================================================
# slack-app-data-capture — environment configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Gateway URL (set this on the CLI side, not here) ---
# This gateway runs on a remote server with a public domain name (e.g. gateway.example.com).
# The opencode CLI on your local machine connects TO this gateway.
# There is no OPENCODE_URL here — the gateway never calls back to the CLI.
#
# On your local machine, point the CLI at this gateway:
#   SLACK_GATEWAY_URL=https://gateway.example.com
#   SLACK_GATEWAY_KEY=<same value as API_KEY below>

# --- Slack App Credentials ---
# Create a Slack app at https://api.slack.com/apps
# Enable Socket Mode and create an App-Level Token with connections:write scope
# Add bot scopes: chat:write, channels:history, groups:history, im:history

# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Slack channel where questions will be posted
# Can be a channel name (#opencode-questions) or channel ID (C0123456789)
SLACK_CHANNEL=#opencode-questions

# --- Gateway Settings ---
# How often to poll opencode for new questions (seconds)
POLL_INTERVAL=3

# Port to run the gateway HTTP server on
PORT=8080

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Storage ---
# Path to SQLite database file (persisted via Docker volume)
DB_PATH=./data/gateway.db

# --- Security (REQUIRED) ---
# All API routes (except GET /health) are protected by bearer-token auth.
# API_KEY must be set — the container will refuse to start without it.
#
# Generate a strong key:
#   openssl rand -hex 32
#
# Use it in requests:
#   curl -H "Authorization: Bearer <your-key>" http://localhost:8080/questions
#
# Security properties enforced at runtime:
#   - Constant-time HMAC comparison (no timing attacks)
#   - Per-IP rate limit: 10 failed attempts per 60 s → HTTP 429
#   - /docs, /redoc, /openapi.json are disabled (no API surface leakage)
API_KEY=replace-me-with-openssl-rand-hex-32
