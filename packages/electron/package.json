{
  "name": "@opencode-ai/electron",
  "private": true,
  "version": "1.2.10",
  "description": "Electron wrapper for the OpenCode web app",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc && electron-builder",
    "typecheck": "tsc --noEmit",
    "pack": "tsc && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.6.2"
  }
}
